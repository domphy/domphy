# Dependencies
node_modules/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Lock files (keep only pnpm-lock.yaml)
package-lock.json
yarn.lock

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/settings.json

# Environment
.env
.env.local
.env.*.local

# npm token
.npmrc

# TypeScript
*.tsbuildinfo

# Package build output
packages/*/dist/

# DomphyPress build output + caches
apps/web/.dp-dist/
apps/web/.dp-cache/
apps/web/.vitepress/dist/
apps/web/.vitepress/cache/
node_modules/.cache/domphy-mermaid/

# npm pack artifacts
*.tgz

# Chart demo/debug artifacts (screenshots, ad-hoc bundles)
packages/chart/*.png
packages/chart/*-bundle.js

# Claude Code local state / agent worktrees
.claude/

.ui-qa/


# Visual / Playwright local
apps/web/visual/.serve/
apps/web/test-results/
apps/web/visual/shots-review-*/
apps/web/playwright-report/

# Local GH Actions failure dumps
.gh-action-logs/


# Local sequential peer-audit working notes
.stable-audit/


# Third-party reference clones for clean-room comparison (local only)
reference/

# LaTeX build artifacts (paper.pdf itself stays tracked — the docs site
# links to it via github.com/domphy/domphy/blob/main/paper/paper.pdf)
paper/*.aux
paper/*.fdb_latexmk
paper/*.fls
paper/*.out
paper/*.synctex.gz

# Smoke-test artifacts (smoke/)
smoke/.tarballs/
smoke/fixtures/*/node_modules/
smoke/fixtures/*/package-lock.json
smoke/fixtures/*/dist/
