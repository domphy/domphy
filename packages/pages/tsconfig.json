{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "build",
    "noEmit": true
  },
  "include": [
    "src",
    "engine/index.ts",
    "engine/types.ts",
    "engine/expression.ts",
    "engine/runtime.ts",
    "engine/model.ts",
    "engine/pageVocabulary.ts"
  ]
}
