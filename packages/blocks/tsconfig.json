{
  "compilerOptions": {
    "target": "ES2018",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*",
    "e2e/**/*",
    "scripts/**/*",
    "tests/**/*",
    "demo-main.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "tsup.config.ts",
    "vite.demo.config.ts"
  ]
}
