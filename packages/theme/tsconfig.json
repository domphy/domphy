{
  "compilerOptions": {
    "target": "ES2018",
    // Palette.ts uses Object.fromEntries (ES2019, Chrome 73 — inside the
    // Chrome 88 embedded-host floor), which the ES2018 target's lib does not
    // declare: `tsc --noEmit -p .` failed with TS2550 while tsup's own DTS
    // build passed, so the package shipped types that never type-checked in
    // isolation. Lib only; `target` stays ES2018 so emitted syntax is unchanged.
    "lib": ["ES2019", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "declaration": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "e2e/**/*",
    "demo-main.ts",
    "demo-matrix.ts",
    "playwright.config.ts",
    "vite.demo.config.ts"
  ]
}
