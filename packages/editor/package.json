{
  "name": "@domphy/editor",
  "version": "0.1.0",
  "description": "Domphy Editor - headless rich-text editor with a Tiptap-compatible API, self-contained engine (no ProseMirror), Domphy adapter with bubble menu",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./domphy": {
      "import": {
        "types": "./dist/domphy.d.ts",
        "default": "./dist/domphy.js"
      },
      "require": {
        "types": "./dist/domphy.d.cts",
        "default": "./dist/domphy.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "pack": "tsup && npm pack",
    "prepublishOnly": "node ../../scripts/guard-pnpm-publish.mjs && npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "domphy",
    "editor",
    "rich-text",
    "wysiwyg",
    "tiptap",
    "headless"
  ],
  "author": "Huu Khanh Nguyen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/domphy/domphy.git",
    "directory": "packages/editor"
  },
  "peerDependencies": {
    "@domphy/core": "workspace:^",
    "@domphy/theme": "workspace:^"
  },
  "dependencies": {
    "@domphy/floating": "workspace:^"
  },
  "devDependencies": {
    "@domphy/core": "workspace:*",
    "@domphy/theme": "workspace:*",
    "jsdom": "^29.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ]
}
